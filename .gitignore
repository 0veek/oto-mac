# -----------------------------------------------------------------------------
# Operating system metadata
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Node.js package managers and dependency caches
# -----------------------------------------------------------------------------
/node_modules/
/.npm/
/.pnpm-store/
/.yarn/cache/
/.yarn/install-state.gz
/.yarn/unplugged/
*.tsbuildinfo

# Keep dependency lockfiles in Git. They make application builds reproducible.

# -----------------------------------------------------------------------------
# SvelteKit, Vite, test, and frontend build output
# -----------------------------------------------------------------------------
/.svelte-kit/
/build/
/dist/
/.vite/
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/package/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# -----------------------------------------------------------------------------
# Rust, Cargo, and Tauri output
# -----------------------------------------------------------------------------
/target/
/src-tauri/target/
/src-tauri/gen/
**/*.rs.bk
*.profraw
perf.data*
core
core.*

# Cargo.lock is intentionally committed because Oto is an application.

# Generated platform icon sets that are not used by the macOS bundle.
/src-tauri/icons/64x64.png
/src-tauri/icons/Square*.png
/src-tauri/icons/StoreLogo.png
/src-tauri/icons/android/
/src-tauri/icons/ios/

# Native bundles, installers, symbols, and local release directories.
*.app/
*.dSYM/
*.xcarchive/
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.msi
*.msix
*.exe
*.app.tar.gz
*.sig
/artifacts/
/releases-local/

# Xcode user and derived state.
DerivedData/
xcuserdata/
*.xcuserstate

